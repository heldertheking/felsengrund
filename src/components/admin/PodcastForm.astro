---
// Shared create/edit form for podcast episodes, used by /admin/podcast/new and
// /admin/podcast/[slug]. This form fully replaces the standalone upload-audio tool: the audio
// file upload is part of the same save action as the rest of the episode's fields.
import type { PodcastEpisode } from '../../lib/admin-content'

interface Props {
  episode?: PodcastEpisode | null
}

const { episode = null } = Astro.props
const isEdit = episode !== null

const inputClass =
  'mt-1 w-full rounded-lg border border-kf-edge bg-kf-surface px-3 py-2 text-sm text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent'
const fileInputClass =
  'mt-1 w-full rounded-lg border border-kf-edge bg-kf-surface px-3 py-2 text-sm text-kf-ink file:mr-3 file:rounded-md file:border-0 file:bg-kf-accent file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-white'
const labelClass = 'text-xs font-semibold uppercase tracking-wide text-kf-ink-muted'
---

<form
  id="podcast-form"
  class="mt-6 flex flex-col gap-5"
  enctype="multipart/form-data"
  data-mode={isEdit ? 'edit' : 'new'}
  data-slug={episode?.slug ?? ''}
>
  {isEdit && <input type="hidden" name="slug" value={episode.slug} />}

  <div>
    <label for="title" class={labelClass}>Titel</label>
    <input type="text" id="title" name="title" required value={episode?.data.title ?? ''} class={inputClass} />
    {isEdit ? (
      <p class="mt-1 text-xs text-kf-ink-muted">
        Slug: <code>{episode.slug}</code>
      </p>
    ) : (
      <p class="mt-1 text-xs text-kf-ink-muted">
        Slug: <code id="slug-preview">–</code>
      </p>
    )}
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <label for="episodeNumber" class={labelClass}>Episodennummer</label>
      <input
        type="number"
        id="episodeNumber"
        name="episodeNumber"
        min="1"
        step="1"
        value={episode?.data.episodeNumber ?? ''}
        class={inputClass}
      />
    </div>
    <div>
      <label for="publishDate" class={labelClass}>Veröffentlichungsdatum</label>
      <input
        type="date"
        id="publishDate"
        name="publishDate"
        required
        value={episode?.data.publishDate ?? ''}
        class={inputClass}
      />
    </div>
  </div>

  <div>
    <label for="duration" class={labelClass}>Dauer (z. B. 32:10)</label>
    <input type="text" id="duration" name="duration" value={episode?.data.duration ?? ''} class={inputClass} />
  </div>

  <div>
    <label for="audio" class={labelClass}>Audiodatei{!isEdit && ' (erforderlich)'}</label>
    {episode?.data.audioUrl && (
      <p class="mt-1 text-xs text-kf-ink-muted">
        Aktuelle Datei: <a href={episode.data.audioUrl} class="text-kf-accent hover:underline" target="_blank">anhören</a>
      </p>
    )}
    <input type="file" id="audio" name="audio" accept="audio/*" required={!isEdit} class={fileInputClass} />
    {isEdit && <p class="mt-1 text-xs text-kf-ink-muted">Leer lassen, um die bestehende Datei zu behalten.</p>}
  </div>

  <div>
    <label for="coverImage" class={labelClass}>Cover-Bild</label>
    {episode?.data.coverImage && (
      <img
        src={episode.data.coverImage}
        alt=""
        class="mt-2 h-24 w-24 rounded-lg border border-kf-edge object-cover"
      />
    )}
    <input type="file" id="coverImage" name="coverImage" accept="image/*" class={fileInputClass} />
  </div>

  <div>
    <label for="body" class={labelClass}>Shownotes (Markdoc)</label>
    <textarea id="body" name="body" rows="14" class={`${inputClass} font-mono`}>{episode?.body ?? ''}</textarea>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-4">
    <button
      type="submit"
      class="rounded-lg bg-kf-accent px-5 py-2.5 font-display text-sm font-semibold text-white transition hover:opacity-90 disabled:opacity-50"
    >
      Speichern
    </button>
    {isEdit && (
      <button
        type="button"
        id="delete-button"
        class="rounded-lg border border-red-600 px-5 py-2.5 font-display text-sm font-semibold text-red-600 transition hover:bg-red-50 disabled:opacity-50"
      >
        Löschen
      </button>
    )}
  </div>

  <p id="status" class="text-sm" role="status"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#podcast-form')
  const status = document.querySelector<HTMLElement>('#status')
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]')
  const deleteButton = document.querySelector<HTMLButtonElement>('#delete-button')
  const slugPreview = document.querySelector<HTMLElement>('#slug-preview')
  const titleInput = document.querySelector<HTMLInputElement>('#title')

  // Mirrors slugify() in src/lib/admin-content.ts for a live preview only — the server is
  // authoritative about the real slug.
  const UMLAUTS: Record<string, string> = { ä: 'ae', ö: 'oe', ü: 'ue', ß: 'ss' }

  function previewSlugify(input: string): string {
    return input
      .toLowerCase()
      .replace(/[äöüß]/g, (char) => UMLAUTS[char] ?? char)
      .normalize('NFKD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
  }

  if (slugPreview && titleInput) {
    const update = () => {
      slugPreview.textContent = previewSlugify(titleInput.value) || '–'
    }
    titleInput.addEventListener('input', update)
    update()
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!status || !form) return

    status.textContent = 'Wird gespeichert …'
    if (submitButton) submitButton.disabled = true

    try {
      const body = new FormData(form)
      const response = await fetch('/api/admin/podcast', { method: 'POST', body, credentials: 'same-origin' })
      if (!response.ok) {
        const data = (await response.json().catch(() => null)) as { error?: string } | null
        throw new Error(data?.error ?? `Fehler ${response.status}`)
      }
      location.href = '/admin/podcast'
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : 'Da ist etwas schiefgelaufen.'
      if (submitButton) submitButton.disabled = false
    }
  })

  deleteButton?.addEventListener('click', async () => {
    const slug = form?.dataset.slug
    if (!slug) return
    if (!confirm('Diese Episode wirklich löschen?')) return

    deleteButton.disabled = true
    try {
      const response = await fetch(`/api/admin/podcast/${slug}`, { method: 'DELETE', credentials: 'same-origin' })
      if (!response.ok) throw new Error(`Fehler ${response.status}`)
      location.href = '/admin/podcast'
    } catch (err) {
      if (status) status.textContent = err instanceof Error ? err.message : 'Löschen fehlgeschlagen.'
      deleteButton.disabled = false
    }
  })
</script>
