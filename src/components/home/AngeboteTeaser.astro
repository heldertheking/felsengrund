---
import { env } from 'cloudflare:workers'
import { listOffers } from '../../lib/admin-content'

// Same category ordering as /angebote and the header dropdown, so the teaser
// surfaces offers in a sensible priority order rather than collection-insertion
// order. The offers store is populated by a parallel workstream and may
// only be partially filled in at any given time — this renders gracefully
// whether there are 0, a few, or many entries.
const categoryOrder = ['gottesdienst', 'kinder-jugend', 'gemeinschaft', 'senioren', 'hilfe-service'] as const

const allOffers = await listOffers(env.STORAGE)
const featured = allOffers
  .slice()
  .sort((a, b) => categoryOrder.indexOf(a.data.category) - categoryOrder.indexOf(b.data.category))
  .slice(0, 4)
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="font-display text-3xl font-bold text-kf-ink">Aktuelle Angebote</h2>
      <p class="mt-2 text-lg text-kf-ink-muted">Für jede Generation etwas – vom Kids-Treff bis zur Seniorenrunde.</p>
    </div>
    <a href="/angebote" class="whitespace-nowrap font-display text-sm font-semibold text-kf-accent hover:underline">
      Alle Angebote ansehen →
    </a>
  </div>

  {featured.length > 0 ? (
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((offer) => (
        <a
          href={`/${offer.slug}`}
          class="rounded-xl border border-kf-edge bg-kf-surface p-5 transition hover:border-kf-accent hover:shadow-md"
        >
          {offer.data.cardImage && (
            <img
              src={offer.data.cardImage}
              alt={offer.data.title}
              class="mb-3 aspect-video w-full rounded-lg object-cover"
            />
          )}
          <p class="font-display font-semibold text-kf-ink">{offer.data.title}</p>
          {offer.data.intro && <p class="mt-1.5 text-sm text-kf-ink-muted">{offer.data.intro}</p>}
        </a>
      ))}
    </div>
  ) : (
    <p class="mt-8 text-sm text-kf-ink-muted">Unsere Angebote werden gerade zusammengestellt – schau bald wieder vorbei.</p>
  )}
</section>
