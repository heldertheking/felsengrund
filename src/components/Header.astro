---
// Grouped by category (the live WordPress site's "Angebote" dropdown is actually a flat,
// unsorted list of ~10 links — see WORDPRESS_SITE_ANALYSIS.md — this grouping is a deliberate
// rework for the rebuild, not a reflection of the old site's markup).
const offerGroups = [
  {
    label: 'Gottesdienst',
    links: [
      { label: 'Gottesdienst', href: '/gottesdienst' },
      { label: 'Dinner Church', href: '/dinner-church' },
    ],
  },
  {
    label: 'Kinder & Jugend',
    links: [
      { label: 'Kids-Treff', href: '/kids-treff' },
      { label: 'Jungschar', href: '/jungschar' },
      { label: 'Highlight', href: '/highlight' },
    ],
  },
  {
    label: 'Gemeinschaft',
    links: [
      { label: 'Smallgroups', href: '/smallgroups' },
      { label: 'Biblischer Unterricht', href: '/biblischer-unterricht' },
    ],
  },
  {
    label: 'Senioren',
    links: [
      { label: 'Senioren', href: '/senioren' },
      { label: 'Seniorenessen 60+', href: '/seniorenessen-60' },
    ],
  },
  {
    label: 'Hilfe & Service',
    links: [
      { label: 'Lebensmittelabgabe', href: '/lebensmittelabgabe' },
      { label: 'Ich brauche Hilfe', href: '/ich-brauche-hilfe' },
    ],
  },
]

const primaryLinks = [
  { label: 'Über uns', href: '/uber-uns' },
  { label: 'Agenda', href: '/agenda' },
]

const secondaryLinks = [
  { label: 'Podcast', href: '/podcast' },
  { label: 'Kontakt & Spenden', href: '/kontakt' },
]
---

<header class="sticky top-0 z-50 border-b border-kf-edge bg-kf-surface/90 backdrop-blur">
  <div class="mx-auto flex h-20 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img
        src="/icons/logo.svg"
        alt="Kirche Felsengrund"
        class="h-14 w-auto"
      />
    </a>

    <nav class="hidden lg:flex lg:items-center lg:gap-1" aria-label="Hauptnavigation">
      <a href="/" class="nav-link">Home</a>
      {primaryLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}

      <div class="group relative">
        <button
          type="button"
          class="nav-link flex items-center gap-1"
          aria-haspopup="true"
          aria-expanded="false"
          data-dropdown-trigger
        >
          Angebote
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </button>

        <div
          class="invisible absolute left-1/2 top-full w-[38rem] -translate-x-1/2 pt-3 opacity-0 transition duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
          data-dropdown-panel
        >
          <div class="grid grid-cols-3 gap-x-6 gap-y-4 rounded-xl border border-kf-edge bg-kf-surface p-6 shadow-lg">
            {offerGroups.map((group) => (
              <div>
                <p class="font-display text-sm font-semibold text-kf-accent">{group.label}</p>
                <ul class="mt-2 space-y-1.5">
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href} class="text-sm text-kf-ink-muted hover:text-kf-accent">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

      {secondaryLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <button
      type="button"
      class="lg:hidden"
      aria-label="Menü öffnen"
      aria-expanded="false"
      data-mobile-trigger
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-7 w-7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
      </svg>
    </button>
  </div>

  <div class="hidden border-t border-kf-edge px-4 pb-4 lg:hidden" data-mobile-panel>
    <nav class="flex flex-col gap-1 pt-3" aria-label="Mobile Navigation">
      <a href="/" class="mobile-nav-link">Home</a>
      {primaryLinks.map((link) => (
        <a href={link.href} class="mobile-nav-link">{link.label}</a>
      ))}

      {offerGroups.map((group) => (
        <div class="pt-2">
          <p class="px-3 font-display text-xs font-semibold uppercase tracking-wide text-kf-ink-muted">
            {group.label}
          </p>
          {group.links.map((link) => (
            <a href={link.href} class="mobile-nav-link">{link.label}</a>
          ))}
        </div>
      ))}

      <div class="pt-2">
        {secondaryLinks.map((link) => (
          <a href={link.href} class="mobile-nav-link">{link.label}</a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style>
  @reference "../styles/global.css";

  .nav-link {
    @apply rounded-md px-3 py-2 font-display text-sm font-medium text-kf-ink transition-colors hover:text-kf-accent;
  }
  .mobile-nav-link {
    @apply rounded-md px-3 py-2 font-display text-sm font-medium text-kf-ink hover:bg-kf-surface-sunken;
  }
</style>

<script>
  const trigger = document.querySelector('[data-mobile-trigger]')
  const panel = document.querySelector('[data-mobile-panel]')

  trigger?.addEventListener('click', () => {
    const isOpen = panel?.classList.toggle('hidden') === false
    trigger.setAttribute('aria-expanded', String(isOpen))
  })
</script>
