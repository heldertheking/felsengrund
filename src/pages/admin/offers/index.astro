---
import { env } from 'cloudflare:workers'
import { verifySession } from '../../../lib/admin-auth'
import { listOffers } from '../../../lib/admin-content'
import AdminLayout from '../../../layouts/AdminLayout.astro'

export const prerender = false

const authenticated = await verifySession(Astro.request.headers.get('cookie'), env.ADMIN_UPLOAD_PASSWORD ?? '')
if (!authenticated) return Astro.redirect('/admin')

const offers = await listOffers(env.STORAGE)
offers.sort((a, b) => a.data.title.localeCompare(b.data.title, 'de-CH'))

const categoryLabels: Record<string, string> = {
  gottesdienst: 'Gottesdienst',
  'kinder-jugend': 'Kinder & Jugend',
  gemeinschaft: 'Gemeinschaft',
  senioren: 'Senioren',
  'hilfe-service': 'Hilfe & Service',
}
---

<AdminLayout title="Angebote – Admin" wide>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-display text-xl font-bold text-kf-ink">Angebote</h1>
    <a
      href="/admin/offers/new"
      class="rounded-lg bg-kf-accent px-4 py-2 font-display text-sm font-semibold text-white transition hover:opacity-90"
    >
      Neues Angebot
    </a>
  </div>

  {offers.length === 0 ? (
    <p class="mt-6 text-sm text-kf-ink-muted">Noch keine Angebote vorhanden.</p>
  ) : (
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-kf-edge text-xs font-semibold uppercase tracking-wide text-kf-ink-muted">
            <th class="py-2 pr-4">Titel</th>
            <th class="py-2 pr-4">Kategorie</th>
            <th class="py-2 pr-4"></th>
          </tr>
        </thead>
        <tbody>
          {offers.map((offer) => (
            <tr class="border-b border-kf-edge/60" data-row data-slug={offer.slug}>
              <td class="py-2 pr-4 text-kf-ink">{offer.data.title}</td>
              <td class="py-2 pr-4 text-kf-ink-muted">{categoryLabels[offer.data.category] ?? offer.data.category}</td>
              <td class="py-2 pr-4">
                <div class="flex justify-end gap-3">
                  <a href={`/admin/offers/${offer.slug}`} class="font-semibold text-kf-accent hover:underline">
                    Bearbeiten
                  </a>
                  <button type="button" data-delete={offer.slug} class="font-semibold text-red-600 hover:underline">
                    Löschen
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((button) => {
    button.addEventListener('click', async () => {
      const slug = button.dataset.delete
      if (!slug) return
      if (!confirm(`Angebot "${slug}" wirklich löschen?`)) return

      button.disabled = true
      try {
        const response = await fetch(`/api/admin/offers/${slug}`, { method: 'DELETE', credentials: 'same-origin' })
        if (!response.ok) throw new Error(`Fehler ${response.status}`)
        button.closest('[data-row]')?.remove()
      } catch {
        alert('Löschen fehlgeschlagen.')
        button.disabled = false
      }
    })
  })
</script>
