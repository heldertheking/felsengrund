---
import { env } from 'cloudflare:workers'
import { verifySession } from '../../../lib/admin-auth'
import AdminLayout from '../../../layouts/AdminLayout.astro'
import PodcastForm from '../../../components/admin/PodcastForm.astro'

export const prerender = false

const authenticated = await verifySession(Astro.request.headers.get('cookie'), env.ADMIN_UPLOAD_PASSWORD ?? '')
if (!authenticated) return Astro.redirect('/admin')
---

<AdminLayout title="Neue Episode – Admin" wide>
  <h1 class="font-display text-xl font-bold text-kf-ink">Neue Podcast-Episode</h1>
  <PodcastForm episode={null} />
</AdminLayout>
