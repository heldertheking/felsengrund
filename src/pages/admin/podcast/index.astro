---
import { env } from 'cloudflare:workers'
import { verifySession } from '../../../lib/admin-auth'
import { listPodcastEpisodes } from '../../../lib/admin-content'
import AdminLayout from '../../../layouts/AdminLayout.astro'

export const prerender = false

const authenticated = await verifySession(Astro.request.headers.get('cookie'), env.ADMIN_UPLOAD_PASSWORD ?? '')
if (!authenticated) return Astro.redirect('/admin')

const episodes = await listPodcastEpisodes(env.STORAGE)
episodes.sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate))
---

<AdminLayout title="Podcast – Admin" wide>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-display text-xl font-bold text-kf-ink">Podcast-Episoden</h1>
    <a
      href="/admin/podcast/new"
      class="rounded-lg bg-kf-accent px-4 py-2 font-display text-sm font-semibold text-white transition hover:opacity-90"
    >
      Neue Episode
    </a>
  </div>

  {episodes.length === 0 ? (
    <p class="mt-6 text-sm text-kf-ink-muted">Noch keine Episoden vorhanden.</p>
  ) : (
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-kf-edge text-xs font-semibold uppercase tracking-wide text-kf-ink-muted">
            <th class="py-2 pr-4">Titel</th>
            <th class="py-2 pr-4">Datum</th>
            <th class="py-2 pr-4"></th>
          </tr>
        </thead>
        <tbody>
          {episodes.map((episode) => (
            <tr class="border-b border-kf-edge/60" data-row data-slug={episode.slug}>
              <td class="py-2 pr-4 text-kf-ink">{episode.data.title}</td>
              <td class="py-2 pr-4 text-kf-ink-muted">{episode.data.publishDate}</td>
              <td class="py-2 pr-4">
                <div class="flex justify-end gap-3">
                  <a href={`/admin/podcast/${episode.slug}`} class="font-semibold text-kf-accent hover:underline">
                    Bearbeiten
                  </a>
                  <button type="button" data-delete={episode.slug} class="font-semibold text-red-600 hover:underline">
                    Löschen
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((button) => {
    button.addEventListener('click', async () => {
      const slug = button.dataset.delete
      if (!slug) return
      if (!confirm(`Episode "${slug}" wirklich löschen?`)) return

      button.disabled = true
      try {
        const response = await fetch(`/api/admin/podcast/${slug}`, { method: 'DELETE', credentials: 'same-origin' })
        if (!response.ok) throw new Error(`Fehler ${response.status}`)
        button.closest('[data-row]')?.remove()
      } catch {
        alert('Löschen fehlgeschlagen.')
        button.disabled = false
      }
    })
  })
</script>
