---
import { env } from 'cloudflare:workers'
import { listOffers } from '../lib/admin-content'
import BaseLayout from '../layouts/BaseLayout.astro'

export const prerender = false

const offers = await listOffers(env.STORAGE)

const categoryOrder = ['gottesdienst', 'kinder-jugend', 'gemeinschaft', 'senioren', 'hilfe-service'] as const
const categoryLabels: Record<string, string> = {
  gottesdienst: 'Gottesdienst',
  'kinder-jugend': 'Kinder & Jugend',
  gemeinschaft: 'Gemeinschaft',
  senioren: 'Senioren',
  'hilfe-service': 'Hilfe & Service',
}
---

<BaseLayout title="Angebote – Kirche Felsengrund" description="Alle Angebote von Kirche Felsengrund im Überblick.">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl font-bold text-kf-ink">Angebote</h1>
    <p class="mt-4 text-lg text-kf-ink-muted">Alle unsere Programme auf einen Blick.</p>

    {categoryOrder.map((category) => {
      const items = offers.filter((offer) => offer.data.category === category)
      // "Ich brauche Hilfe" is a standalone static page, not an R2 offer, but it belongs
      // alongside the real hilfe-service offers here — so this category always renders,
      // even if there happen to be zero matching R2 offers.
      const isHilfeService = category === 'hilfe-service'
      if (items.length === 0 && !isHilfeService) return null
      return (
        <div class="mt-12">
          <h2 class="font-display text-xl font-semibold text-kf-accent">{categoryLabels[category]}</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((offer) => (
              <a
                href={`/${offer.slug}`}
                class="rounded-xl border border-kf-edge bg-kf-surface p-5 transition hover:border-kf-accent hover:shadow-md"
              >
                {offer.data.cardImage && (
                  <img
                    src={offer.data.cardImage}
                    alt={offer.data.title}
                    class="mb-3 aspect-video w-full rounded-lg object-cover"
                  />
                )}
                <p class="font-display font-semibold text-kf-ink">{offer.data.title}</p>
                {offer.data.intro && <p class="mt-1.5 text-sm text-kf-ink-muted">{offer.data.intro}</p>}
              </a>
            ))}
            {isHilfeService && (
              <a
                href="/ich-brauche-hilfe"
                class="rounded-xl border border-kf-edge bg-kf-surface p-5 transition hover:border-kf-accent hover:shadow-md"
              >
                <p class="font-display font-semibold text-kf-ink">Ich brauche Hilfe</p>
                <p class="mt-1.5 text-sm text-kf-ink-muted">
                  Gebet und vertrauliche Lebensberatung – wir sind für dich da, wenn du Unterstützung brauchst.
                </p>
              </a>
            )}
          </div>
        </div>
      )
    })}
  </section>
</BaseLayout>
