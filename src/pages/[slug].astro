---
import { env } from 'cloudflare:workers'
import { getOffer, renderMarkdoc } from '../lib/admin-content'
import BaseLayout from '../layouts/BaseLayout.astro'

export const prerender = false

const { slug } = Astro.params
const offer = slug ? await getOffer(env.STORAGE, slug) : null

if (!offer) {
  return Astro.rewrite('/404')
}

const categoryLabels: Record<string, string> = {
  gottesdienst: 'Gottesdienst',
  'kinder-jugend': 'Kinder & Jugend',
  gemeinschaft: 'Gemeinschaft',
  senioren: 'Senioren',
  'hilfe-service': 'Hilfe & Service',
}
---

<BaseLayout title={`${offer.data.title} – Kirche Felsengrund`} description={offer.data.intro}>
  <article class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
   <div class="mx-auto max-w-3xl">
    {offer.data.cardImage && (
      <img
        src={offer.data.cardImage}
        alt={offer.data.title}
        class="mb-6 aspect-video w-full rounded-xl object-cover"
      />
    )}
    <p class="font-display text-sm font-semibold uppercase tracking-wide text-kf-accent">
      {categoryLabels[offer.data.category]}
    </p>
    <h1 class="mt-2 font-display text-4xl font-bold text-kf-ink">{offer.data.title}</h1>
    {offer.data.intro && <p class="mt-4 text-lg text-kf-ink-muted">{offer.data.intro}</p>}

    <dl class="mt-8 grid grid-cols-1 gap-4 rounded-xl border border-kf-edge bg-kf-surface-sunken p-6 sm:grid-cols-2">
      {offer.data.schedule && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-kf-ink-muted">Zeitplan</dt>
          <dd class="mt-1 text-sm text-kf-ink">{offer.data.schedule}</dd>
        </div>
      )}
      {offer.data.location && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-kf-ink-muted">Ort</dt>
          <dd class="mt-1 text-sm text-kf-ink">
            {offer.data.mapsLink ? (
              <a href={offer.data.mapsLink} class="text-kf-accent hover:underline">{offer.data.location}</a>
            ) : (
              offer.data.location
            )}
          </dd>
        </div>
      )}
      {offer.data.targetAudience && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-kf-ink-muted">Zielgruppe</dt>
          <dd class="mt-1 text-sm text-kf-ink">{offer.data.targetAudience}</dd>
        </div>
      )}
      {offer.data.registration && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-kf-ink-muted">Anmeldung</dt>
          <dd class="mt-1 text-sm text-kf-ink">{offer.data.registration}</dd>
        </div>
      )}
    </dl>

    <div class="prose prose-neutral mt-10 max-w-none">
      <Fragment set:html={renderMarkdoc(offer.body)} />
    </div>

    {offer.data.organizers && offer.data.organizers.length > 0 && (
      <div class="mt-10 border-t border-kf-edge pt-6">
        <p class="font-display text-sm font-semibold text-kf-ink">Ansprechpersonen</p>
        <ul class="mt-3 space-y-2">
          {offer.data.organizers.map((person) => (
            <li class="text-sm text-kf-ink-muted">
              <span class="font-medium text-kf-ink">{person.name}</span>
              {person.role && <> — {person.role}</>}
              {person.contact && <> · {person.contact}</>}
            </li>
          ))}
        </ul>
      </div>
    )}
   </div>
  </article>
</BaseLayout>
