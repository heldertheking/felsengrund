---
import BaseLayout from '../layouts/BaseLayout.astro'
import HilfeHero from '../components/hilfe/HilfeHero.astro'

interface PublishedPrayerRequest {
  id: string
  topic: string
  displayName: string
  description: string
}

interface PrayerTheme {
  label: string
  requests: PublishedPrayerRequest[]
}

// TODO: this page currently always renders the empty state below. Once the n8n/storage backend
// for prayer-wall submissions exists, populate `themes` with real, published (opted-in) prayer
// requests grouped by theme instead of this static placeholder. The live site only ever showed one
// theme in the crawl ("Leidtragende" – "those suffering"); keep that as the default group but allow
// more themes to appear once real data flows in.
const themes: PrayerTheme[] = [{ label: 'Leidtragende', requests: [] }]
---

<BaseLayout
  title="Gebetswand – Kirche Felsengrund"
  description="Bete mit für Menschen, die gerade Leid tragen – anonym veröffentlichte Gebetsanliegen aus unserer Gemeinde."
>
  <HilfeHero
    eyebrow="Hilfe & Service"
    title="Gebetswand"
    lead="Hier sammeln wir Gebetsanliegen, die Menschen mit uns geteilt und zur Veröffentlichung freigegeben haben. Nimm dir einen Moment Zeit und bete für Menschen, die gerade still Leid tragen."
    image="/images/gebet.jpg"
    imageAlt="Menschen im Gebet"
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    {themes.map((theme) => (
      <div class="mt-4 first:mt-0">
        <h2 class="font-display text-xl font-semibold text-kf-accent">{theme.label}</h2>

        {theme.requests.length === 0 ? (
          <div class="mt-4 rounded-2xl border border-dashed border-kf-edge bg-kf-surface-sunken p-6 text-center sm:p-10">
            <p class="font-display font-semibold text-kf-ink">
              Aktuell keine veröffentlichten Gebetsanliegen
            </p>
            <p class="mt-2 text-sm text-kf-ink-muted">
              Sobald jemand ein Anliegen einreicht und der Veröffentlichung zustimmt, erscheint es hier.
            </p>
            <a
              href="/jetzt-fuer-mich-beten"
              class="mt-5 inline-flex items-center justify-center rounded-lg bg-kf-accent px-5 py-2.5 font-display text-sm font-semibold text-white transition hover:opacity-90"
            >
              Eigenes Anliegen einreichen
            </a>
          </div>
        ) : (
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {theme.requests.map((request) => (
              <div class="rounded-xl border border-kf-edge bg-kf-surface p-5">
                <p class="font-display text-sm font-semibold text-kf-ink">{request.topic}</p>
                <p class="mt-2 text-sm text-kf-ink-muted">{request.description}</p>
                <p class="mt-3 text-xs uppercase tracking-wide text-kf-ink-muted">
                  {request.displayName}
                </p>
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>
</BaseLayout>
