{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "felsengrund",
  "compatibility_date": "2026-06-12",
  "main": "src/worker/index.ts",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "felsengrund-storage"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_CDN_DOMAIN": "https://cdn.kirche-felsengrund.ch"
  },
  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview",
        "PUBLIC_CDN_DOMAIN": "https://cdn-preview.kirche-felsengrund.ch"
      }
    }
  }
}
