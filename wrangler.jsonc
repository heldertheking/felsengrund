{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "felsengrund",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "felsengrund-storage"
    }
  ],
  "vars": {
    "PUBLIC_CDN_DOMAIN": "https://felsengrund-cdn.heldertheking.com",
    // Update once the real n8n workflow exists. Not secret by itself (auth is the
    // N8N_WEBHOOK_SECRET header, see src/lib/notify.ts / .dev.vars.example) but replace the
    // placeholder host before relying on it.
    "N8N_WEBHOOK_URL": "https://REPLACE-ME.n8n.cloud/webhook/felsengrund-forms"
  }
}
