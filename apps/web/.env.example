# Copy to .env for local development. In CI, this is injected as a build-time env var
# pointing at the deployed Worker's URL (production/staging) — Astro inlines PUBLIC_*
# vars at build time, so this must be set before `astro build` runs, not at serve time.
PUBLIC_API_BASE_URL=http://localhost:8787
GOOGLE_CALENDAR_EMBED_URL=link_to_calendar