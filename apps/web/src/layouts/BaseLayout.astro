---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // Set by pages with a client-only dynamic title (offer/episode detail, admin) that render their own breadcrumb.
  hideBreadcrumbs?: boolean;
}

const {
  title = 'Kirche Felsengrund - Kirche, die verändert',
  description = 'Kirche Felsengrund in Oetwil am See: Gottesdienste, Angebote für Kinder, Jugend, Senioren und Gemeinschaft, sowie soziale Hilfsangebote.',
  hideBreadcrumbs = false,
} = Astro.props;

// Every page gets a "Home / ..." breadcrumb derived from its URL, unless it opts out via hideBreadcrumbs.
const SEGMENT_LABELS: Record<string, string> = {
  agenda: 'Agenda',
  angebote: 'Angebote',
  podcast: 'Podcast',
  admin: 'Admin',
  datenschutz: 'Datenschutz',
  'ich-brauche-hilfe': 'Ich brauche Hilfe',
  'jetzt-fuer-mich-beten': 'Jetzt für mich beten',
  kontakt: 'Kontakt',
  lebensberatung: 'Lebensberatung',
  'uber-uns': 'Über uns',
  wegbeschreibung: 'Wegbeschreibung',
};

const segments = Astro.url.pathname.split('/').filter(Boolean);
const showBreadcrumbs = !hideBreadcrumbs && segments.length > 0;

let crumbHref = '';
const breadcrumbs = segments.map((segment, index) => {
  crumbHref += `/${segment}`;
  return {
    label: SEGMENT_LABELS[segment] ?? segment,
    href: index === segments.length - 1 ? undefined : crumbHref,
  };
});
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    <Header />
    <main class="flex-1">
      {showBreadcrumbs && (
        <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs text-kf-ink-muted">
            <a href="/" class="hover:text-kf-accent hover:underline underline-offset-2">
              Home
            </a>
            {breadcrumbs.map((crumb) => (
              <span class="flex items-center gap-1.5">
                <span aria-hidden="true">/</span>
                {crumb.href ? (
                  <a href={crumb.href} class="hover:text-kf-accent hover:underline underline-offset-2">
                    {crumb.label}
                  </a>
                ) : (
                  <span aria-current="page" class="text-kf-ink">
                    {crumb.label}
                  </span>
                )}
              </span>
            ))}
          </nav>
        </div>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>
