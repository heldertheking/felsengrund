---
export interface AgendaItem {
  title: string;
  cadence: string;
  note?: string;
  link?: string;
}

interface Props {
  item: AgendaItem;
}

const { item } = Astro.props;

const isExternal = item.link?.startsWith('http://') || item.link?.startsWith('https://');
const hasLink = Boolean(item.link && item.link.trim().length > 0);
---

<li class="rounded-xl border border-kf-edge bg-kf-surface p-5 hover:border-kf-accent transition-colors">
  {hasLink ? (
    <a
      href={item.link}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      class="block h-full w-full"
    >
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
        <p class="font-display font-semibold text-kf-ink">{item.title}</p>
        <p class="text-sm font-medium text-kf-accent">{item.cadence}</p>
      </div>
      {item.note && <p class="mt-2 text-sm text-kf-ink-muted">{item.note}</p>}
    </a>
  ) : (
    <div>
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
        <p class="font-display font-semibold text-kf-ink">{item.title}</p>
        <p class="text-sm font-medium text-kf-accent">{item.cadence}</p>
      </div>
      {item.note && <p class="mt-2 text-sm text-kf-ink-muted">{item.note}</p>}
    </div>
  )}
</li>
