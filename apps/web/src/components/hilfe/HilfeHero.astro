---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image: string;
  imageAlt: string;
}

const { eyebrow, title, lead, image, imageAlt } = Astro.props;
---

<section class="border-b border-kf-edge bg-kf-surface-sunken">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:items-center md:py-20">
    <div>
      {eyebrow && <p class="font-display text-sm font-semibold uppercase tracking-wide text-kf-accent">{eyebrow}</p>}
      <h1 class="mt-2 font-display text-4xl font-bold text-kf-ink sm:text-5xl">{title}</h1>
      {lead && <p class="mt-4 text-lg text-kf-ink-muted">{lead}</p>}
      <slot />
    </div>
    <img src={image} alt={imageAlt} class="aspect-[4/3] w-full rounded-2xl object-cover shadow-md" />
  </div>
</section>
