---
/**
 * Shows its content only while the field `when` has one of the values in `is`
 * (comma-separated). BaseForm's script does the toggling: hidden content is removed from the
 * accessibility tree and all its controls are disabled, so they are neither validated nor sent.
 * Works for radios, selects, text inputs and checkboxes (checked value; unchecked = no value).
 * Conditionals can be nested.
 *
 *   <FormConditional when="contact" is="phone">
 *     <FormField label="Telefon" name="phone" type="tel" required />
 *   </FormConditional>
 */
interface Props {
  /** `name` of the controlling field. */
  when: string;
  /** Value(s) of that field that reveal the content, comma-separated. */
  is: string;
}

const { when, is } = Astro.props;
---

<div class="flex flex-col gap-6" data-show-when={when} data-show-is={is}>
  <slot />
</div>
