---
/** Single checkbox (e.g. privacy consent). The label may contain HTML/links via the default slot. */
interface Props {
  name: string;
  required?: boolean;
  value?: string;
  /** Preset as checked. Also the state a form reset returns to. */
  checked?: boolean;
  id?: string;
}

const { name, required = false, value = 'on', checked = false, id = `field-${name}` } = Astro.props;
---

<div class="flex flex-col gap-1.5" data-field>
  <label for={id} class="flex min-h-11 items-start gap-2 py-2 text-sm text-kf-ink">
    <input
      id={id}
      type="checkbox"
      name={name}
      value={value}
      required={required}
      checked={checked}
      class="mt-0.5 h-4 w-4 shrink-0 rounded border-kf-edge text-kf-accent focus:outline-none focus:ring-2 focus:ring-kf-accent/40"
    />
    <span>
      <slot />
      {
        required && (
          <span class="text-kf-accent" aria-hidden="true">
            {' '}
            *
          </span>
        )
      }
    </span>
  </label>
  <p id={`${id}-error`} data-field-error hidden class="text-sm text-red-700"></p>
</div>
