---
// The "Angebote" dropdown groups reflect live content managed via /admin, so they're fetched
// client-side from the Worker API rather than baked into the page at build time — see the
// inline <script> below.
const primaryLinks = [
  { label: 'Über uns', href: '/uber-uns' },
  { label: 'Agenda', href: '/agenda' },
];

const secondaryLinks = [
  { label: 'Podcast', href: '/podcast' },
  { label: 'Kontakt & Spenden', href: '/kontakt' },
];
---

<header class="relative sticky top-0 z-50 border-b border-kf-edge bg-kf-surface/90 backdrop-blur">
  <!--
    Discreet admin entry point: click 5x within ~2s to reveal a link to /admin. A plain invisible
    button (not the logo) so it never interferes with normal navigation, and not part of the tab
    order / not exposed to assistive tech, since it's deliberately not meant to be discoverable.
  -->
  <button
    type="button"
    class="hidden lg:block absolute right-0 top-0 h-20 w-12"
    tabindex="-1"
    aria-hidden="true"
    data-admin-trigger
  ></button>

  <div
    class="hidden lg:block invisible absolute right-4 top-full z-50 mt-1 w-48 rounded-xl border border-kf-edge bg-kf-surface p-2 opacity-0 shadow-lg transition"
    data-admin-panel
  >
    <a href="/admin" class="block rounded-md px-3 py-2 text-sm text-kf-ink hover:bg-kf-surface-sunken">
      Admin öffnen
    </a>
  </div>

  <div class="mx-auto flex h-20 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img
        src="/images/logo.svg"
        alt="Kirche Felsengrund"
        class="h-14 w-auto"
      />
    </a>

    <nav class="hidden lg:flex lg:items-center lg:gap-1" aria-label="Hauptnavigation">
      <a href="/" class="nav-link">Home</a>
      {primaryLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}

      <div class="group relative">
        <button
          type="button"
          class="nav-link flex items-center gap-1"
          aria-haspopup="true"
          aria-expanded="false"
          data-dropdown-trigger
        >
          Angebote
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </button>

        <div
          class="invisible absolute left-1/2 top-full w-[38rem] -translate-x-1/2 pt-3 opacity-0 transition duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
          data-dropdown-panel
        >
          <div
            class="grid grid-cols-3 gap-x-6 gap-y-4 rounded-xl border border-kf-edge bg-kf-surface p-6 shadow-lg"
            data-offer-groups
          ></div>
        </div>
      </div>

      {secondaryLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <button
      type="button"
      class="-mr-2 p-2 lg:hidden"
      aria-label="Menü öffnen"
      aria-expanded="false"
      data-mobile-trigger
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-7 w-7" aria-hidden="true">
        <path class="mobile-trigger-bar mobile-trigger-bar-top" stroke-linecap="round" d="M3.75 6.75h16.5"></path>
        <path class="mobile-trigger-bar mobile-trigger-bar-middle" stroke-linecap="round" d="M3.75 12h16.5"></path>
        <path class="mobile-trigger-bar mobile-trigger-bar-bottom" stroke-linecap="round" d="M3.75 17.25h16.5"></path>
      </svg>
    </button>
  </div>

  <div
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out lg:hidden"
    data-mobile-panel
  >
    <div class="min-h-0 overflow-hidden">
      <nav
        class="flex translate-y-[-0.5rem] flex-col divide-y divide-kf-edge/60 border-t border-kf-edge px-4 pb-2 pt-3 opacity-0 transition-[transform,opacity] duration-300 ease-out"
        aria-label="Mobile Navigation"
        data-mobile-nav
      >
        <a href="/" class="mobile-nav-link">Home</a>
        {primaryLinks.map((link) => (
          <a href={link.href} class="mobile-nav-link">{link.label}</a>
        ))}

        <!--
          Unlike the desktop dropdown, the mobile menu deliberately only links to the "Angebote"
          overview page instead of expanding every individual offer inline — with a growing,
          admin-managed offer list that would make the mobile menu unreasonably long and messy.
        -->
        <a href="/angebote" class="mobile-nav-link">Angebote</a>

        {secondaryLinks.map((link) => (
          <a href={link.href} class="mobile-nav-link">{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  @reference "../styles/global.css";

  .nav-link {
    @apply rounded-md px-3 py-2 font-display text-sm font-medium text-kf-ink transition-colors hover:text-kf-accent;
  }
  .mobile-nav-link {
    @apply rounded-md px-3 py-3 font-display text-sm font-medium text-kf-ink hover:bg-kf-surface-sunken;
  }

  .mobile-trigger-bar {
    transform-origin: center;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  [data-mobile-trigger][aria-expanded='true'] .mobile-trigger-bar-top {
    transform: translateY(5.25px) rotate(45deg);
  }
  [data-mobile-trigger][aria-expanded='true'] .mobile-trigger-bar-middle {
    opacity: 0;
  }
  [data-mobile-trigger][aria-expanded='true'] .mobile-trigger-bar-bottom {
    transform: translateY(-5.25px) rotate(-45deg);
  }
</style>

<script>
  import { apiUrl } from '../lib/api'

  const trigger = document.querySelector<HTMLButtonElement>('[data-mobile-trigger]')
  const panel = document.querySelector<HTMLElement>('[data-mobile-panel]')
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]')
  let mobileMenuOpen = false

  const setMobileMenuOpen = (isOpen: boolean) => {
    mobileMenuOpen = isOpen
    panel?.classList.toggle('grid-rows-[1fr]', isOpen)
    panel?.classList.toggle('grid-rows-[0fr]', !isOpen)
    mobileNav?.classList.toggle('opacity-0', !isOpen)
    mobileNav?.classList.toggle('translate-y-[-0.5rem]', !isOpen)
    if (mobileNav) mobileNav.inert = !isOpen
    trigger?.setAttribute('aria-expanded', String(isOpen))
    trigger?.setAttribute('aria-label', isOpen ? 'Menü schliessen' : 'Menü öffnen')
  }

  trigger?.addEventListener('click', () => setMobileMenuOpen(!mobileMenuOpen))

  const dropdownTrigger = document.querySelector('[data-dropdown-trigger]')
  const dropdownGroup = dropdownTrigger?.closest('.group')
  dropdownGroup?.addEventListener('focusin', () => dropdownTrigger?.setAttribute('aria-expanded', 'true'))
  dropdownGroup?.addEventListener('focusout', (event) => {
    if (event instanceof FocusEvent && !event.relatedTarget) {
      dropdownTrigger?.setAttribute('aria-expanded', 'false')
    }
  })
  dropdownGroup?.addEventListener('mouseenter', () => dropdownTrigger?.setAttribute('aria-expanded', 'true'))
  dropdownGroup?.addEventListener('mouseleave', () => dropdownTrigger?.setAttribute('aria-expanded', 'false'))

  // The "Angebote" groups reflect live content, so they're fetched client-side from the
  // Worker API (cross-origin) rather than baked into the page at build time.
  interface OfferNavGroup {
    label: string
    links: { label: string; href: string }[]
  }

  const desktopOfferGroups = document.querySelector<HTMLElement>('[data-offer-groups]')

  const escapeHtml = (value: string) =>
    value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')

  fetch(apiUrl('/nav'))
    .then((response) => {
      if (!response.ok) throw new Error(`/nav responded with ${response.status}`)
      return response.json() as Promise<OfferNavGroup[]>
    })
    .then((groups) => {
      if (desktopOfferGroups) {
        desktopOfferGroups.innerHTML = groups
          .map(
            (group) => `
              <div>
                <p class="font-display text-sm font-semibold text-kf-accent">${escapeHtml(group.label)}</p>
                <ul class="mt-2 space-y-1.5">
                  ${group.links
                    .map(
                      (link) => `
                        <li>
                          <a href="${escapeHtml(link.href)}" class="text-sm text-kf-ink-muted hover:text-kf-accent">
                            ${escapeHtml(link.label)}
                          </a>
                        </li>
                      `,
                    )
                    .join('')}
                </ul>
              </div>
            `,
          )
          .join('')
      }
    })
    .catch((error) => {
      console.error('Failed to load offer nav', error)
    })

  const adminTrigger = document.querySelector<HTMLButtonElement>('[data-admin-trigger]')
  const adminPanel = document.querySelector<HTMLElement>('[data-admin-panel]')
  let adminClickCount = 0
  let adminResetTimer: ReturnType<typeof setTimeout> | undefined

  adminTrigger?.addEventListener('click', () => {
    adminClickCount += 1
    clearTimeout(adminResetTimer)
    adminResetTimer = setTimeout(() => (adminClickCount = 0), 2000)

    if (adminClickCount >= 5) {
      adminClickCount = 0
      adminPanel?.classList.remove('invisible', 'opacity-0')
    }
  })

  document.addEventListener('click', (event) => {
    if (!adminPanel || adminPanel.classList.contains('invisible')) return
    if (
      event.target instanceof Node &&
      !adminPanel.contains(event.target) &&
      event.target !== adminTrigger
    ) {
      adminPanel.classList.add('invisible', 'opacity-0')
    }
  })
</script>
