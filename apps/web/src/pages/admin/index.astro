---
// SPA entry for /admin - .htaccess rewrites every /admin/* path here since this is internal
// tooling with client-side view state, not statically-enumerable pages. No BaseLayout: no
// public header/nav/footer (noindex, standalone chrome).
import '../../styles/global.css';
import AdminApp from '../../components/admin/AdminApp';
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Kirche Felsengrund – Admin</title>
  </head>
  <body class="bg-kf-surface-sunken font-sans">
    <AdminApp client:load />
  </body>
</html>
