---
import BaseLayout from '../../layouts/BaseLayout.astro'
import OffersGrid from '../../components/OffersGrid'
---

<BaseLayout title="Angebote – Kirche Felsengrund" description="Alle Angebote von Kirche Felsengrund im Überblick.">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-kf-ink-muted">
      <a href="/" class="hover:text-kf-accent hover:underline underline-offset-2">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page" class="text-kf-ink">Angebote</span>
    </nav>
    <h1 class="font-display text-4xl font-bold text-kf-ink">Angebote</h1>
    <p class="mt-4 text-lg text-kf-ink-muted">Alle unsere Programme auf einen Blick.</p>

    <OffersGrid client:load />
  </section>
</BaseLayout>
