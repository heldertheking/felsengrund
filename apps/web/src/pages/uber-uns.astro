---
import BaseLayout from '../layouts/BaseLayout.astro'

interface CoreValue {
  name: string
  description: string
}

const coreValues: CoreValue[] = [
  {
    name: 'Evangelium',
    description:
      'Die gute Nachricht von Jesus Christus steht im Zentrum von allem, was wir glauben und tun.',
  },
  {
    name: 'Glaube',
    description: 'Wir vertrauen Gott in allen Lebenslagen und laden andere ein, diesen Glauben zu entdecken.',
  },
  {
    name: 'Hoffnung',
    description:
      'Wir leben aus der Hoffnung, die uns durch die Auferstehung von Jesus Christus geschenkt ist.',
  },
  {
    name: 'Liebe',
    description: 'Wir begegnen einander und unserem Umfeld mit der Liebe, die wir selbst von Gott empfangen haben.',
  },
]

interface LeadershipMember {
  image: string
  name: string
  role: string
  detail: string
}
// TODO: Update images & Other Members
const leadershipTeam: LeadershipMember[] = [
  {
    image: '/images/portraits/oliver_lutz.png',
    name: 'Oliver Lutz, PhD',
    role: 'Pastor',
    detail: 'Theologe, jahrgang 1969',
  },
  {
    image: '/images/portraits/erwin_meier.png',
    name: 'Erwin Meier',
    role: 'Gemeindeleiter',
    detail: 'Jahrgang 1967, engagiert in Lobpreis- und Gebetsversammlungen.',
  },
  {
    image: '/images/portraits/tabea_meier.png',
    name: 'Tabea Meier',
    role: 'Jugendleiterin',
    detail: 'Jahrgang 1991, ausgebildete Pflegefachfrau.',
  },
  {
    image: '/images/portraits/sonja_lutz.png',
    name: 'Sonja Lutz',
    role: 'Leiterin Kinderprogramm',
    detail: 'Jahrgang 1969.',
  },
]
---

<BaseLayout
  title="Über uns – Kirche Felsengrund"
  description="Wer wir sind: Vision, Glaubensgrundlage, Leitungsteam und Werte der Kirche Felsengrund in Oetwil am See."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl font-bold text-kf-ink sm:text-5xl">Über uns</h1>

    <div class="mt-6 max-w-3xl space-y-4 text-lg text-kf-ink-muted">
      <p>
        Kirche Felsengrund ist eine evangelische Freikirche ("Freie Missionsgemeinde") in Oetwil am
        See. Wir sind Mitglied im <a href="https://www.vfmg.ch/" class="hover:text-kf-accent">Verband Freier Missionsgemeinden Schweiz</a>.
      </p>
      <p>
        Wir glauben an den einen Gott: Gott den Vater, Jesus Christus, seinen Sohn, und den Heiligen
        Geist. Wir glauben, dass Jesus Christus gestorben und auferstanden ist und dass diese
        Auferstehung uns neues Leben und Hoffnung schenkt.
      </p>
    </div>
  </section>

  <section class="bg-kf-surface-sunken py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="font-display text-2xl font-bold text-kf-ink">Unsere Werte</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {coreValues.map((value) => (
          <div class="rounded-xl border border-kf-edge bg-kf-surface p-5">
            <p class="font-display font-semibold text-kf-accent">{value.name}</p>
            <p class="mt-2 text-sm text-kf-ink-muted">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="font-display text-2xl font-bold text-kf-ink">Leitungsteam</h2>
    <p class="mt-2 max-w-2xl text-kf-ink-muted">
      Diese Menschen tragen die Leitung unserer Gemeinde.
    </p>
    <!-- TODO: Bild muss erstellt werder-->
    <img
      src="/images/gemeindes_leitung.jpg"
      alt="Das Gemeindeleitungsteam vor dem Felsengrund Gebäude"
      class="mt-6 w-full max-w-2xl rounded-xl border border-kf-edge object-cover"
    />

    <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {leadershipTeam.map((member) => (
        <li class="rounded-xl border border-kf-edge bg-kf-surface p-5">
          <div class="flex flex-row gap-5">
            <img src={member.image} onerror="this.src = '/images/portraits/placeholder.png'" alt={`Bild von ${member.name}`} class="aspect-square w-25 rounded-full border-kf-edge"/>
            <div>
              <p class="font-display font-semibold text-kf-ink">{member.name}</p>
              <p class="text-sm font-medium text-kf-accent">{member.role}</p>
              <p class="mt-2 text-sm text-kf-ink-muted">{member.detail}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
