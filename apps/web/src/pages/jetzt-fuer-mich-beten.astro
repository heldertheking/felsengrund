---
import BaseLayout from '../layouts/BaseLayout.astro'
import HilfeHero from '../components/hilfe/HilfeHero.astro'
import FormField from '../components/hilfe/FormField.astro'
import RadioGroup from '../components/hilfe/RadioGroup.astro'
import FormStatus from '../components/hilfe/FormStatus.astro'
---

<BaseLayout
  title="Betet für mich – Kirche Felsengrund"
  description="Reiche ein Gebetsanliegen ein – unser Gebetsteam betet vertraulich für dich."
>
  <HilfeHero
    eyebrow="Hilfe & Service"
    title="Betet für mich"
    lead="Wir glauben, dass Gebet wirkt. Reiche dein Anliegen ein – unser Gebetsteam nimmt es vertraulich entgegen und betet für dich, solange du es brauchst."
    image="/images/gebet.jpg"
    imageAlt="Menschen im Gebet"
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
   <div class="mx-auto max-w-2xl">
    <h2 class="font-display text-2xl font-semibold text-kf-ink">Gebetsanliegen einreichen</h2>
    <p class="mt-3 rounded-xl border border-kf-edge bg-kf-surface-sunken p-4 text-sm text-kf-ink-muted">
      <strong class="font-semibold text-kf-ink">Vertraulich:</strong> Dein Anliegen wird ausschliesslich
      von unserem Gebetsteam gelesen.
    </p>

    <form id="prayer-request-form" class="mt-8 flex flex-col gap-6">
      <FormField label="Um welches Thema geht es?" name="topic" required>
        <input
          type="text"
          id="topic"
          name="topic"
          required
          class="rounded-lg border border-kf-edge bg-kf-surface px-3 py-2.5 lg:py-2 text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent"
        />
      </FormField>

      <FormField label="Wie möchtest du genannt werden?" name="displayName" required>
        <input
          type="text"
          id="displayName"
          name="displayName"
          required
          class="rounded-lg border border-kf-edge bg-kf-surface px-3 py-2.5 lg:py-2 text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent"
        />
      </FormField>

      <FormField label="Dein Gebetsanliegen" name="description" required>
        <textarea
          id="description"
          name="description"
          required
          rows={5}
          class="rounded-lg border border-kf-edge bg-kf-surface px-3 py-2.5 lg:py-2 text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent"
        ></textarea>
      </FormField>

      <FormField label="E-Mail" name="email" hint="Nur falls du über dein Anliegen benachrichtigt werden möchtest.">
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          class="rounded-lg border border-kf-edge bg-kf-surface px-3 py-2.5 lg:py-2 text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent"
        />
      </FormField>

      <div class="flex flex-col gap-2 pt-2">
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-lg bg-kf-accent px-5 py-3 lg:py-2.5 font-display text-sm font-semibold text-white transition hover:opacity-90"
        >
          Anliegen senden
        </button>
        <FormStatus id="prayer-request-status" />
      </div>
    </form>
   </div>
  </section>
</BaseLayout>

<script>
  import { apiUrl } from '../lib/api'

  const form = document.querySelector('#prayer-request-form')
  const status = document.querySelector('#prayer-request-status')

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return

    const submitButton = form.querySelector('button[type="submit"]')
    const payload = Object.fromEntries(new FormData(form).entries())

    status.textContent = 'Wird gesendet …'
    status.dataset.state = 'pending'
    if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true

    try {
      const response = await fetch(apiUrl('/prayer-request'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })

      if (!response.ok) throw new Error(`Unexpected status ${response.status}`)

      status.textContent = 'Danke! Dein Anliegen ist bei uns angekommen – wir beten für dich.'
      status.dataset.state = 'success'
      form.reset()
    } catch (error) {
      console.error('Failed to submit prayer request', error)
      status.textContent =
        'Das hat leider nicht geklappt. Bitte versuche es später erneut oder schreib uns direkt an oliver.lutz@kirche-felsengrund.ch.'
      status.dataset.state = 'error'
    } finally {
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false
    }
  })
</script>
