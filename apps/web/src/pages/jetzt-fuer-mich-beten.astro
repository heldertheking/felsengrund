---
import BaseLayout from '../layouts/BaseLayout.astro';
import HilfeHero from '../components/hilfe/HilfeHero.astro';
import FormField from '../components/form/FormField.astro';
import BaseForm from '../components/form/BaseForm.astro';
import FormCheckbox from '../components/form/FormCheckbox.astro';
import FormRow from '../components/form/FormRow.astro';
import FormConditional from '../components/form/FormConditional.astro';
---

<BaseLayout
  title="Betet für mich - Kirche Felsengrund"
  description="Reiche ein Gebetsanliegen ein - unser Gebetsteam betet vertraulich für dich."
>
  <HilfeHero
    eyebrow="Hilfe & Service"
    title="Betet für mich"
    lead="Wir glauben, dass Gebet wirkt. Reiche dein Anliegen ein - unser Gebetsteam nimmt es vertraulich entgegen und betet für dich, solange du es brauchst."
    image="/images/gebet.jpg"
    imageAlt="Menschen im Gebet"
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-display text-2xl font-semibold text-kf-ink">Gebetsanliegen einreichen</h2>
      <p class="mt-3 rounded-xl border border-kf-edge bg-kf-surface-sunken p-4 text-sm text-kf-ink-muted">
        <strong class="font-semibold text-kf-ink">Vertraulich:</strong> Dein Anliegen wird ausschliesslich von unserem
        Gebetsteam gelesen.
      </p>

      <BaseForm formId="prayer" submitLabel="Gebetsanliegen senden" class="mt-8">
        <FormField name="topic" required autocomplete="off" label="Um welches Thema geht es?" />
        <FormField name="description" required as="textarea" label="Erzähle uns mehr" />
        <FormRow>
          <FormCheckbox id="pr-anonymous" name="anonymous" checked>
            Ich möchte anonym bleiben.
          </FormCheckbox>
          <FormCheckbox id="pr-answer" name="answer">
            Ich möchte eine rückmeldung erhalten.
          </FormCheckbox>
        </FormRow>
        <FormConditional when="anonymous" is="!on">
          <FormField name="displayName" required autocomplete="name" label="Wie sollen wir dich nennen?" />
        </FormConditional>
        <FormConditional when="answer" is="on">
          <FormField name="email" required autocomplete="email" label="E-mail Adresse" />
        </FormConditional>
      </BaseForm>
    </div>
  </section>
</BaseLayout>
