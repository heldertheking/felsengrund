---
import BaseLayout from '../layouts/BaseLayout.astro';
import BaseForm from '../components/form/BaseForm.astro';
import FormField from '../components/form/FormField.astro';
---

<BaseLayout
  title="Kontakt & Spenden - Kirche Felsengrund"
  description="Kontaktiere die Kirche Felsengrund oder unterstütze uns mit einer Spende."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl font-bold text-kf-ink sm:text-5xl">Kontakt & Spenden</h1>
    <p class="mt-4 max-w-2xl text-lg text-kf-ink-muted">
      Wir freuen uns über deine Nachricht - ob Frage, Anliegen oder einfach ein "Hallo".
    </p>

    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-xl font-semibold text-kf-ink">Schreib uns</h2>

        <BaseForm formId="contact" label="contact form" class="mt-8">
          <FormField name="name" required autocomplete="name" label="Name" />
          <FormField name="email" required autocomplete="email" label="Email" />
          <FormField name="subject" required autocomplete="off" label="Betreff" />
          <FormField name="message" required autocomplete="off" label="Nachricht" as="textarea" />
        </BaseForm>
      </div>

      <div class="space-y-10">
        <div>
          <h2 class="font-display text-xl font-semibold text-kf-ink">Ansprechperson</h2>
          <p class="mt-3 text-kf-ink-muted">
            Oliver Lutz
            <br />
            <a href="tel:+41449291587" class="text-kf-accent underline underline-offset-2">
              044 929 15 87
            </a>
            <br />
            <a href="mailto:oliver.lutz@kirche-felsengrund.ch" class="text-kf-accent underline underline-offset-2">
              oliver.lutz@kirche-felsengrund.ch
            </a>
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl font-semibold text-kf-ink">Adresse</h2>
          <p class="mt-3 text-kf-ink-muted">
            Kirche Felsengrund
            <br />
            Felsengrund 1<br />
            8618 Oetwil am See
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl font-semibold text-kf-ink">Spenden</h2>
          <p class="mt-3 text-kf-ink-muted">
            Wir freuen uns über jede Unterstützung — herzlichen Dank für deine Spende.
          </p>
          <dl class="mt-4 space-y-2 rounded-xl border border-kf-edge bg-kf-surface-sunken p-5 text-sm">
            <div>
              <dt class="font-semibold text-kf-ink">Kontoinhaber</dt>
              <dd class="text-kf-ink-muted">Freie Missionsgemeinde Oetwil am See</dd>
            </div>
            <div>
              <dt class="font-semibold text-kf-ink">IBAN</dt>
              <dd class="text-kf-ink-muted">CH79 0070 0114 6002 0178 2</dd>
            </div>
          </dl>
          <div class="mt-4 flex items-center gap-4 rounded-xl border border-kf-edge bg-kf-surface p-5">
            <img
              src="/images/qr-zahlteil-spende.png"
              alt="Swiss QR-Code für Spenden an Freie Missionsgemeinde Oetwil am See"
              class="h-auto w-28 shrink-0"
            />
            <p class="text-sm text-kf-ink-muted">
              Mit der Banking-App oder TWINT deines Kontos einscannen, um direkt mit den hinterlegten Spendendaten zu
              bezahlen.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const subjectParam = new URLSearchParams(window.location.search).get('subject'); // Gathers URL parameters

  if (subjectParam) {
    const subjectElement = document.querySelector('#field-subject') as HTMLInputElement | null;
    if (subjectElement) {
      subjectElement.value = `${String(subjectParam).charAt(0).toUpperCase() + String(subjectParam).slice(1)}`;
    }
  }
</script>
