---
import BaseLayout from '../layouts/BaseLayout.astro';
import HilfeHero from '../components/hilfe/HilfeHero.astro';
import FormField from '../components/form/FormField.astro';
import BaseForm from '../components/form/BaseForm.astro';
import FormRadioGroup from '../components/form/FormRadioGroup.astro';
import FormConditional from '../components/form/FormConditional.astro';

const contactOptions = [
  { value: 'email', label: 'E-Mail' },
  { value: 'phone', label: 'Telefon' },
]
const counselorOptions = [
  { value: 'none', label: 'Keine Präferenz' },
  { value: 'female', label: 'Weiblich' },
  { value: 'male', label: 'Männlich' },
  // { value: 'other', label: 'Sonstiges' },
]
---

<BaseLayout
  title="Lebensberatung - Kirche Felsengrund"
  description="Kostenlose, vertrauliche Lebensberatung - wir melden uns innerhalb von 48 Stunden bei dir."
>
  <HilfeHero
    eyebrow="Hilfe & Service"
    title="Lebensberatung"
    lead="Ein offenes Ohr für das, was dich beschäftigt. Unsere Lebensberatung ist kostenlos, vertraulich und für alle offen - wir melden uns innerhalb von 48 Stunden bei dir zurück."
    image="/images/leiter.jpg"
    imageAlt="Ansprechpersonen von Kirche Felsengrund"
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-display text-2xl font-semibold text-kf-ink">Beratung anfragen</h2>
      <p class="mt-3 text-kf-ink-muted">
        Erzähl uns kurz, worum es geht. Deine Angaben werden vertraulich behandelt und nur für die Beratung verwendet.
      </p>

      <BaseForm formId="counseling">
        <FormField name="name" required autocomplete="name" label="Name" />
        <FormField name="subject" required autocomplete="off" label="Thema" />
        <FormField name="message" required autocomplete="off" label="Nachricht" as="textarea"/>
        <FormRadioGroup name="contact-preference" required options={contactOptions} legend="Bevorzugte Kontaktart" />
        <FormConditional when="contact-preference" is="email">
          <FormField label="E-Mail" name="email" type="email" required autocomplete="email" />
        </FormConditional>
        <FormConditional when="contact-preference" is="phone">
          <FormField label="Telefon" name="phone" type="tel" required autocomplete="tel" />
        </FormConditional>
        <FormRadioGroup name="counselor-preference" options={counselorOptions} legend="Bevorzugtes Geschlecht der beratenden Person" />
      </BaseForm>
    </div>
  </section>
</BaseLayout>