---
import BaseLayout from '../layouts/BaseLayout.astro'
import HilfeHero from '../components/hilfe/HilfeHero.astro'
import FormField from '../components/hilfe/FormField.astro'
import RadioGroup from '../components/hilfe/RadioGroup.astro'
import FormStatus from '../components/hilfe/FormStatus.astro'
---

<BaseLayout
  title="Lebensberatung – Kirche Felsengrund"
  description="Kostenlose, vertrauliche Lebensberatung – wir melden uns innerhalb von 48 Stunden bei dir."
>
  <HilfeHero
    eyebrow="Hilfe & Service"
    title="Lebensberatung"
    lead="Ein offenes Ohr für das, was dich beschäftigt. Unsere Lebensberatung ist kostenlos, vertraulich und für alle offen – wir melden uns innerhalb von 48 Stunden bei dir zurück."
    image="/images/leiter.jpg"
    imageAlt="Ansprechpersonen von Kirche Felsengrund"
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
   <div class="mx-auto max-w-2xl">
    <h2 class="font-display text-2xl font-semibold text-kf-ink">Beratung anfragen</h2>
    <p class="mt-3 text-kf-ink-muted">
      Erzähl uns kurz, worum es geht. Deine Angaben werden vertraulich behandelt und nur für die
      Beratung verwendet.
    </p>

    <form id="counseling-form" class="mt-8 flex flex-col gap-6">
      <FormField label="Name" name="name" required>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          class="rounded-lg border border-kf-edge bg-kf-surface px-3 py-2.5 text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent"
        />
      </FormField>

      <FormField label="E-Mail" name="email" required>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          class="rounded-lg border border-kf-edge bg-kf-surface px-3 py-2.5 text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent"
        />
      </FormField>

      <FormField label="Telefon" name="phone">
        <input
          type="tel"
          id="phone"
          name="phone"
          autocomplete="tel"
          class="rounded-lg border border-kf-edge bg-kf-surface px-3 py-2.5 text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent"
        />
      </FormField>

      <FormField label="Betreff" name="subject" required>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          class="rounded-lg border border-kf-edge bg-kf-surface px-3 py-2.5 text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent"
        />
      </FormField>

      <FormField label="Nachricht" name="message" required>
        <textarea
          id="message"
          name="message"
          required
          rows={5}
          class="rounded-lg border border-kf-edge bg-kf-surface px-3 py-2.5 text-kf-ink focus:border-kf-accent focus:outline-none focus:ring-1 focus:ring-kf-accent"
        ></textarea>
      </FormField>

      <RadioGroup
        legend="Bevorzugte Kontaktart"
        name="preferredContactMethod"
        required
        options={[
          { value: 'email', label: 'E-Mail' },
          { value: 'phone', label: 'Telefon' },
        ]}
      />

      <RadioGroup
        legend="Bevorzugtes Geschlecht der beratenden Person"
        name="preferredCounselorGender"
        options={[
          { value: 'female', label: 'Weiblich' },
          { value: 'male', label: 'Männlich' },
        ]}
      />

      <div class="flex flex-col gap-2 pt-2">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-kf-accent px-5 py-2.5 font-display text-sm font-semibold text-white transition hover:opacity-90"
        >
          Anfrage senden
        </button>
        <FormStatus id="counseling-status" />
      </div>
    </form>
   </div>
  </section>
</BaseLayout>

<script>
  import { apiUrl } from '../lib/api'

  const form = document.querySelector('#counseling-form')
  const status = document.querySelector('#counseling-status')

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return

    const submitButton = form.querySelector('button[type="submit"]')
    const payload = Object.fromEntries(new FormData(form).entries())

    status.textContent = 'Wird gesendet …'
    status.dataset.state = 'pending'
    if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true

    try {
      const response = await fetch(apiUrl('/counseling'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })

      if (!response.ok) throw new Error(`Unexpected status ${response.status}`)

      status.textContent = 'Danke! Wir melden uns innerhalb von 48 Stunden bei dir zurück.'
      status.dataset.state = 'success'
      form.reset()
    } catch (error) {
      console.error('Failed to submit counseling request', error)
      status.textContent =
        'Das hat leider nicht geklappt. Bitte versuche es später erneut oder schreib uns direkt an oliver.lutz@kirche-felsengrund.ch.'
      status.dataset.state = 'error'
    } finally {
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false
    }
  })
</script>
