---
import BaseLayout from '../layouts/BaseLayout.astro';
import HilfeHero from '../components/hilfe/HilfeHero.astro';

const offerings = [
  {
    title: 'Betet für mich',
    href: '/jetzt-fuer-mich-beten',
    description: 'Reiche ein Gebetsanliegen ein - unser Gebetsteam nimmt es vertraulich entgegen und betet für dich.',
    cta: 'Jetzt für mich beten',
  },
  {
    title: 'Lebensberatung',
    href: '/lebensberatung',
    description:
      'Vertrauliches, kostenloses Gespräch mit einer Ansprechperson aus unserer Gemeinde - wir melden uns innerhalb von 48 Stunden bei dir.',
    cta: 'Beratung anfragen',
  },
];
---

<BaseLayout
  title="Ich brauche Hilfe - Kirche Felsengrund"
  description="Gebet und vertrauliche Lebensberatung: Kirche Felsengrund ist für dich da, wenn du Unterstützung brauchst."
>
  <HilfeHero
    eyebrow="Hilfe & Service"
    title="Ich brauche Hilfe"
    lead="Du musst nicht allein durch schwierige Zeiten gehen. Wir glauben, dass Gebet wirkt, und wir sind auch persönlich für dich da - vertraulich, kostenlos und ohne Verpflichtung."
    image="/images/gebet.jpg"
    imageAlt="Menschen im Gebet"
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {offerings.map((offering) => (
        <a
          href={offering.href}
          class="flex flex-col rounded-2xl border border-kf-edge bg-kf-surface p-8 transition hover:border-kf-accent hover:shadow-md"
        >
          <h2 class="font-display text-2xl font-semibold text-kf-ink">{offering.title}</h2>
          <p class="mt-3 flex-1 text-kf-ink-muted">{offering.description}</p>
          <span class="mt-6 inline-flex items-center gap-1 font-display text-sm font-semibold text-kf-accent">
            {offering.cta}
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M8.22 5.22a.75.75 0 011.06 0l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 010-1.06z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </span>
        </a>
      ))}
    </div>

    <p class="mt-10 text-sm text-kf-ink-muted">
      Solltest du sonst Gebetsanliegen haben, melde dich bei uns über das{' '}
      <a href="/jetzt-fuer-mich-beten" class="text-kf-accent underline underline-offset-2">
        Gebetsanliegen-Formular
      </a>
      .
    </p>
  </section>
</BaseLayout>
