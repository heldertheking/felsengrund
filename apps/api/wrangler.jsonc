{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "felsengrund",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  // Persists console.log/warn/error output (and request metadata) to the Cloudflare dashboard's
  // Workers Logs, so past requests are inspectable after the fact instead of only being visible
  // while `wrangler tail` is attached live.
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "felsengrund-storage"
    }
  ],
  "vars": {
    // Update once the real n8n workflow exists. Not secret by itself (auth is the
    // N8N_WEBHOOK_SECRET header, see packages/api-core/src/notify.ts / .dev.vars.example) but
    // replace the placeholder host before relying on it.
    "N8N_WEBHOOK_URL": "https://REPLACE-ME.n8n.cloud/webhook/felsengrund-forms",

    // This Worker's own public origin. Used to rewrite relative /media/<key> paths (as stored
    // by admin-content.ts) into absolute URLs before they're returned to the frontend, since
    // frontend and API are now different origins.
    "PUBLIC_WORKER_ORIGIN": "https://felsengrund.jroliveirahelder.workers.dev",

    // Comma-separated list of frontend origins allowed to call this API (see
    // src/middleware/cors.ts). "https://*.kirche-felsengrund.ch" matches the apex domain plus
    // any subdomain (www, staging, develop, ...); localhost:4321 covers local `astro dev`.
    "ALLOWED_ORIGINS": "http://localhost:4321,https://*.kirche-felsengrund.ch"
  }
}
