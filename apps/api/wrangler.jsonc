{
  "$schema": "https://www.unpkg.com/wrangler/config-schema.json",
  "name": "felsengrund",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true // Enable log persistence in cloudflare dashboard
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "felsengrund-storage"
    }
  ],
  "ratelimits": [
    {
      "name": "FORMS_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "KFA_SESSION_TTL_MS": "43200000",
    "KFA_WORKER_ORIGIN": "https://felsengrund.jroliveirahelder.workers.dev",
    "KFA_WEBPAGE_ORIGIN": "https://staging.kirche-felsengrund.ch",
    "KFA_ALLOWED_ORIGINS": "http://localhost:4321,https://*.kirche-felsengrund.ch"
  },
  "secrets": {
    "required": ["KFA_ADMIN_PASSWORD", "KFA_MAIL_PASSWORD", "KFA_DEV_NOTIFICATION_RECIPIENT"]
  },
  "env": {
    // Variables and bindings are not inherit
    "production": {
      "name": "felsengrund",
      "vars": {
        "ENVIRONMENT": "production",
        "KFA_SESSION_TTL_MS": "43200000",
        "KFA_WORKER_ORIGIN": "https://felsengrund.jroliveirahelder.workers.dev",
        "KFA_WEBPAGE_ORIGIN": "https://kirche-felsengrund.ch",
        "KFA_ALLOWED_ORIGINS": "https://*.kirche-felsengrund.ch"
      },
      "secrets": {
        "required": ["KFA_ADMIN_PASSWORD", "KFA_MAIL_PASSWORD"]
      },
      "ratelimits": [
        {
          "name": "FORMS_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "felsengrund-storage"
        }
      ]
    },
    "development": {
      "name": "felsengrund",
      "vars": {
        "ENVIRONMENT": "development",
        "KFA_SESSION_TTL_MS": "43200000",
        "KFA_WORKER_ORIGIN": "https://felsengrund.jroliveirahelder.workers.dev",
        "KFA_WEBPAGE_ORIGIN": "https://staging.kirche-felsengrund.ch",
        "KFA_ALLOWED_ORIGINS": "http://localhost:4321,https://*.kirche-felsengrund.ch"
      },
      "secrets": {
        "required": ["KFA_ADMIN_PASSWORD", "KFA_MAIL_PASSWORD", "KFA_DEV_NOTIFICATION_RECIPIENT"]
      },
      "ratelimits": [
        {
          "name": "FORMS_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "felsengrund-storage"
        }
      ]
    }
  }
}
