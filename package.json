{
  "name": "felsengrund",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w @felsengrund/web",
    "dev:api": "npm run dev -w @felsengrund/api",
    "build:web": "npm run build -w @felsengrund/web",
    "build:api": "npm run build -w @felsengrund/api",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.69.0",
    "concurrently": "^10.0.5"
  }
}
