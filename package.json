{
  "name": "felsengrund",
  "description": "Public website and self-service admin panel for Kirche Felsengrund, a church in Oetwil am See, Switzerland — an Astro static site plus a Cloudflare Worker API.",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:types\"",
    "dev:web": "npm run dev -w @felsengrund/web",
    "dev:api": "npm run dev:local -w @felsengrund/api",
    "dev:types": "npm run dev:types -w @felsengrund/api",
    "build:web": "npm run build -w @felsengrund/web",
    "build:api": "npm run build -w @felsengrund/api",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@typescript-eslint/parser": "^8.70.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^15.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "workerd@1.20260926.1": true,
    "esbuild@0.28.1": true
  }
}
