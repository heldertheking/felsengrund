{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "felsengrund-api",
  "compatibility_date": "2026-06-12",
  "main": "src/index.ts",
  "preview_urls": true,
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "felsengrund-storage"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_CDN_DOMAIN": "https://cdn.kirche-felsengrund.ch"
  },
  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview",
        "PUBLIC_CDN_DOMAIN": "https://cdn-preview.kirche-felsengrund.ch"
      }
    }
  }
}
